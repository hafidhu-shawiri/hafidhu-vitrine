# ═══════════════════════════════════════════════════════════════════
# HAFIDHU — SITE VITRINE
# Modèle de configuration — NOMS DE VARIABLES UNIQUEMENT
#
# Copier ce fichier en « .env.local » et y renseigner les vraies valeurs.
# .env.local est ignoré par Git et ne doit JAMAIS être versionné.
#
# ⚠ Ne jamais renseigner de valeur réelle dans CE fichier.
# ═══════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────
# SITE
# ───────────────────────────────────────────────────────────────────
# URL publique du site. C'est LA variable qui pilote toutes les URL
# canoniques, le sitemap et les balises Open Graph.
#
# Phase actuelle  : https://<projet>.vercel.app
# Phase finale    : https://hafidhu.com
#
# Le passage au domaine définitif ne demande que la modification
# de cette seule variable — aucune reconstruction du code.
# Si elle est absente, l'application retombe automatiquement
# sur VERCEL_URL, puis sur http://localhost:3000.
NEXT_PUBLIC_SITE_URL=


# ───────────────────────────────────────────────────────────────────
# SUPABASE
# ───────────────────────────────────────────────────────────────────
# Les deux variables NEXT_PUBLIC_ sont exposées au navigateur.
# C'est normal et sans danger : la Row Level Security est activée
# et aucune politique de lecture n'est ouverte au public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠⚠ CLÉ SENSIBLE — SERVEUR UNIQUEMENT ⚠⚠
# Contourne toutes les politiques RLS.
# Ne doit JAMAIS être préfixée NEXT_PUBLIC_.
# Ne doit JAMAIS être importée depuis un composant client.
# Ne doit JAMAIS être journalisée.
SUPABASE_SERVICE_ROLE_KEY=


# ───────────────────────────────────────────────────────────────────
# MESSAGERIE (SMTP)
# ───────────────────────────────────────────────────────────────────
# ⚠ SERVEUR UNIQUEMENT — aucune de ces valeurs ne doit atteindre
#   le navigateur.
#
# Hôte attendu : smtp.hostinger.com
# Port 465 = SSL implicite  →  SMTP_SECURE=true
# Port 587 = STARTTLS       →  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Expéditeur et destinataire des notifications de formulaire.
SMTP_FROM=
CONTACT_RECIPIENT=


# ───────────────────────────────────────────────────────────────────
# ADMINISTRATION
# ───────────────────────────────────────────────────────────────────
# L'authentification de /admin repose sur Supabase Auth : le mot de
# passe y est stocké sous forme de hachage bcrypt, jamais en clair.
#
# Les deux variables ci-dessous servent EXCLUSIVEMENT à l'amorçage
# du compte administrateur initial, via le script dédié exécuté
# manuellement une seule fois :
#
#     node scripts/create-admin.mjs
#
# Elles ne sont utilisées par AUCUNE route de l'application et ne
# constituent en aucun cas le mécanisme d'authentification.
# Une fois le compte créé, elles peuvent — et devraient — être vidées.
#
# Le mot de passe se change ensuite depuis Supabase, sans toucher au code.
ADMIN_USERNAME=
ADMIN_PASSWORD=


# ───────────────────────────────────────────────────────────────────
# OUTILS DE DÉPLOIEMENT (facultatif — usage local)
# ───────────────────────────────────────────────────────────────────
# Non utilisés par l'application au moment de l'exécution.
GITHUB_TOKEN=
VERCEL_TOKEN=
